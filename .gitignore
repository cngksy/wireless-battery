# Whitelist: only the app's own source, build files and assets are published.
# Personal reports, device dumps, settings and third-party reference files stay local.
/*
!/.gitignore
!/App.cs
!/AssemblyInfo.cs
!/Autostart.cs
!/Battery.cs
!/EightBitDo.cs
!/GHub.cs
!/HyperX.cs
!/IpiPiao.cs
!/Localization.cs
!/LogitechG735.cs
!/LogitechReceivers.cs
!/Native.cs
!/PlayStation.cs
!/RegressionChecks.cs
!/Razer.cs
!/SteelSeries.cs
!/Taskbars.cs
!/Updates.cs
!/UserSettings.cs
!/Widget.cs
!/WindowsDevices.cs
!/WindowsRuntimeBattery.cs
!/app.manifest
!/build.ps1
!/installer.iss
!/README.md
!/LICENSE
!/assets/
!/docs/
!/.github/
